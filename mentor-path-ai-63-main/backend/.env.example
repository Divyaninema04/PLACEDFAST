# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB)
# Provide either local MongoDB or MongoDB Atlas URI:
# e.g. mongodb+srv://<username>:<password>@cluster.mongodb.net/placementpilot?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/placementpilot

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# External AI & Web Scraper Integrations
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
LOVABLE_API_KEY=your_gateway_key_here
